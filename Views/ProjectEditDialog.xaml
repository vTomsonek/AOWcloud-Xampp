<Window x:Class="XamppVHostManager.Views.ProjectEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="380" Width="540"
        Icon="/icon.ico"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ServerName -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ServerName (np. projekt1.test)" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" LostFocus="ServerName_LostFocus"/>
        </StackPanel>

        <!-- DocumentRoot -->
        <StackPanel Grid.Row="1" Margin="0,0,0,4">
            <TextBlock Text="Folder projektu (zapisywany WZGLĘDNIE do dysku przenośnego)"
                       Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DocumentRootRelative, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Wybierz…" Click="Browse_Click" Margin="6,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- Podgląd pełnej ścieżki -->
        <TextBlock Grid.Row="2" Margin="0,0,0,12" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                   Text="{Binding AbsoluteDocumentRootPreview, StringFormat='Pełna ścieżka: {0}'}"/>

        <!-- Port + Enabled -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Port" Foreground="{StaticResource SubTextBrush}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" Content="Aktywny (Enabled)" IsChecked="{Binding Enabled}"
                      VerticalAlignment="Bottom" Margin="16,0,0,6"/>
        </Grid>

        <!-- Komunikat walidacji -->
        <TextBlock Grid.Row="4" Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Przyciski -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Anuluj" Click="Cancel_Click" Width="100"/>
            <Button Content="Zapisz" Click="Ok_Click" Style="{StaticResource AccentButton}" Width="100"
                    IsEnabled="{Binding IsValid}"/>
        </StackPanel>
    </Grid>
</Window>
